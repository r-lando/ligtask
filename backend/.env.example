SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY
AUTH_ALLOWED_EMAILS=alice@example.com,bob@example.com

# false only for local HTTP development; true for HTTPS deployments
AUTH_COOKIE_SECURE=false
AUTH_ALLOWED_ORIGINS=http://127.0.0.1:5173
# Also allow this exact URL in Supabase Authentication > URL Configuration.
AUTH_RECOVERY_REDIRECT_URL=http://127.0.0.1:5173/reset-password
# Positive daily per-user quota. 0 disables it for temporary local testing only.
ASSESSMENTS_PER_DAY=5
